<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CsharpExample</RootNamespace>
    <!-- Suppress doc-comment warnings that fire only because of generated skirout files. -->
    <NoWarn>$(NoWarn);1584;1591;1658</NoWarn>
  </PropertyGroup>

  <!-- Suppress specific warnings inside generated skirout files. -->
  <ItemGroup>
    <Compile Update="skirout/**/*.cs">
      <NoWarn>1591;8019;CS0169;CS0649;CS8618;CS0067</NoWarn>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../csharp-client/SkirClient.csproj" />
  </ItemGroup>

</Project>
